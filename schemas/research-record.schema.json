{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalshi-bot.local/schemas/research-record.schema.json",
  "title": "kalshibot research record v2",
  "description": "Research is evidence and suggestions for later review, never an order. Keywords are limited to the subset KalshiBot's validator implements; unknown keywords fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "researchId", "packetId", "packetHash", "createdAtUtc", "validUntilUtc",
               "marketTicker", "eventTicker", "seriesTicker", "marketRulesHash", "disposition", "evidence",
               "uncertainties", "invalidationConditions", "hypothesis", "suggestedModelChange",
               "experimentalProbabilityYes", "researcherVersion"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "kalshibot/research-record/v2" },
    "researchId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
                    "description": "Unique id chosen by the researcher; reusing it for different content is rejected." },
    "packetId": { "type": "string", "pattern": "^pkt_[0-9]+_[0-9a-f]{12}$", "description": "Echo packet.packetId exactly." },
    "packetHash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Echo packet.packetHash exactly." },
    "createdAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$" },
    "validUntilUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$",
                       "description": "When this research stops being usable. At most 14 days after createdAtUtc." },
    "marketTicker": { "type": "string", "minLength": 1, "maxLength": 128 },
    "eventTicker": { "type": "string", "minLength": 1, "maxLength": 128 },
    "seriesTicker": { "anyOf": [ { "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" } ] },
    "marketRulesHash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Echo packet.rules.rulesSha256 exactly." },
    "disposition": { "type": "string", "enum": ["needs_review", "insufficient_evidence", "no_issue_found"],
                     "description": "None of these authorizes a trade." },
    "evidence": {
      "type": "array", "maxItems": 20,
      "description": "Required unless disposition is insufficient_evidence.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "url", "publishedAtUtc", "retrievedAtUtc", "dataHash", "claim"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "url": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "publishedAtUtc": { "anyOf": [ { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$" }, { "type": "null" } ] },
          "retrievedAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$" },
          "dataHash": { "anyOf": [ { "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" } ] },
          "claim": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "uncertainties": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "invalidationConditions": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "hypothesis": { "anyOf": [ { "type": "string", "minLength": 1, "maxLength": 4000 }, { "type": "null" } ] },
    "suggestedModelChange": { "anyOf": [ { "type": "string", "minLength": 1, "maxLength": 4000 }, { "type": "null" } ] },
    "experimentalProbabilityYes": {
      "description": "Optional, for paper scoring only. Never an input to any trading decision.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["value", "method", "uncertainty"],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "method": { "type": "string", "minLength": 1, "maxLength": 300 },
            "uncertainty": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      ]
    },
    "researcherVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["cli", "model", "promptVersion", "toolConfig"],
      "properties": {
        "cli": { "anyOf": [ { "type": "string", "minLength": 1, "maxLength": 100 }, { "type": "null" } ] },
        "model": { "anyOf": [ { "type": "string", "minLength": 1, "maxLength": 100 }, { "type": "null" } ] },
        "promptVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
        "toolConfig": { "anyOf": [ { "type": "string", "minLength": 1, "maxLength": 300 }, { "type": "null" } ] }
      }
    }
  }
}
